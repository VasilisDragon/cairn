{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "description": "Cairn — reliability-first AI Minecraft agent. LLM strategic planner + deterministic safety substrate.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js src/index.js",
    "check": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/check-js.js",
    "test:unit": "node scripts/run-offline-tests.js",
    "test:offline": "npm run test:unit",
    "test:det": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/deterministic-eval.js",
    "test:grep": "node scripts/check-pathfinder-writes.js",
    "test:live": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/live-suite.js",
    "live:scenario": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/run-live-scenario.js",
    "live:admin": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/live-admin.js",
    "advisor:dry-run": "node scripts/advisor-dry-run.js",
    "advisor:first-call": "node scripts/advisor-first-call.js",
    "advisor:f3": "node scripts/advisor-f3-calibration.js",
    "advisor:replay": "node scripts/advisor-first-call-replay.js",
    "advisor:live-plan": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/advisor-live-plan.js",
    "advisor:live-calibration": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/advisor-live-calibration.js",
    "advisor:live-calibration-case": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/advisor-live-calibration-case.js",
    "advisor:response-capture-guard": "node scripts/advisor-response-capture-guard.js",
    "benchmark:detection-rate": "node scripts/detection-rate-benchmark.js",
    "benchmark:missions": "node scripts/mission-reliability-benchmark.js",
    "benchmark:ladder": "node scripts/benchmark-ladder.js",
    "capability:matrix": "node scripts/capability-matrix.js",
    "advisor:preflight": "node scripts/deepseek-preflight.js",
    "test:live:phase2": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js scripts/live-phase2.js",
    "test:baseline": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 scripts/run-baseline.js",
    "test:all": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 scripts/run-test-all.js",
    "phase0": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js test/phase0_snapshot.js",
    "phase1": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js test/phase1_survival.js",
    "phase2": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js test/phase2_collect.js",
    "phase3": "node --env-file=./config/low-impact-node.env --v8-pool-size=1 --import ./scripts/resource-lock-bootstrap.js test/phase3_calibration.js"
  },
  "dependencies": {
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "mineflayer-armor-manager": "^2.0.1",
    "openai": "^4.79.1",
    "minecraft-data": "^3.110.2",
    "prismarine-nbt": "^2.8.0",
    "vec3": "^0.1.10"
  }
}
