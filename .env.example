# Copy this to .env (gitignored) and fill in real values.
# Either set these env vars OR populate keys.json — both are read.

DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
MCBOT_ADVISOR_COST_USD_MAX=2.00

# Account regime:
# - test = Regime A/private-LAN development, offline MCBot account (default)
# - production = Regime B/user's Microsoft account, post-F4 only
MCBOT_ACCOUNT_REGIME=test
MCBOT_USER_ELSEWHERE_KICK_COOLDOWN_MS=60000
# Optional Regime B token-cache directory; omit to use Mineflayer's default .minecraft cache.
# MCBOT_MICROSOFT_PROFILE_CACHE_DIR=/path/to/.minecraft

# Minecraft connection (overrides config.json if set).
# Regime A keeps auth=offline and username=MCBot for current live/RCON fixtures.
# Regime B forces auth=microsoft and requires MC_USERNAME to be the user's account.
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.21.11
MC_USERNAME=MCBot
MC_AUTH=offline

# Chat-originated control commands are intentionally disabled. Use local process
# signals or an authenticated operator/RCON channel for administrative shutdown.

# C1 humanization is opt-in. When disabled, wrappers pass through to Mineflayer.
MCBOT_HUMANIZE=0

# F2 live advisor-plan reporter. These do nothing unless the live command is
# explicitly run with MCBOT_LIVE_TESTS=1 and MCBOT_ALLOW_DEEPSEEK=1.
MCBOT_LIVE_ADMIN_OK=0
MCBOT_RCON_HOST=127.0.0.1
MCBOT_RCON_PORT=25575
MCBOT_RCON_PASSWORD=
